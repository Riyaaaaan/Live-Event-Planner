# Firebase (from Firebase Console → Project settings → General / Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push (Firebase Console → Project settings → Cloud Messaging → Web Push certificates)
# Generate a key pair if none exists; use the "Key pair" value here for FCM client token.
VITE_FIREBASE_VAPID_KEY=
